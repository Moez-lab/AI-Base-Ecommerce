# Existing API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=products

# LangSmith Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=shopai-assistant

# Pinecone Configuration
USE_PINECONE=true

# Kafka/Redpanda Configuration
KAFKA_BROKER=localhost:19092
KAFKA_CLIENT_ID=ecommerce-app
KAFKA_GROUP_ID=recommendation-consumers

# PostgreSQL Data Warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recommendations

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Model Serving API (will be set up in Phase 5)
MODEL_API_URL=http://localhost:8000
MODEL_API_TIMEOUT=5000

# Feature Flags
ENABLE_EVENT_STREAMING=true
ENABLE_ML_RECOMMENDATIONS=false
ENABLE_AB_TESTING=false
